#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
main_script="$script_dir/main.py"
if [ ! -f "$main_script" ]; then
    main_script="/usr/lib/installatore-apk/main.py"
fi
python_bin=${INSTALLATORE_APK_PYTHON:-/usr/bin/python3}
adb_command=${ADB:-adb}

show_error() {
    message=$1
    printf '%s\n' "$message" >&2
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="Installatore Apk" --text="$message" >/dev/null 2>&1 || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send "Installatore Apk" "$message" >/dev/null 2>&1 || true
    fi
}

check_gui() {
    "$python_bin" -c 'import gi; gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1"); from gi.repository import Gtk, Adw' >/dev/null 2>&1
}

install_dependencies() {
    dependencies="python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 adb xdg-utils desktop-file-utils"
    if command -v apt-get >/dev/null 2>&1; then
        if [ "$(id -u)" -eq 0 ]; then
            apt-get install -y --no-install-recommends $dependencies >/dev/null 2>&1 || true
        elif command -v pkexec >/dev/null 2>&1; then
            pkexec apt-get install -y --no-install-recommends $dependencies >/dev/null 2>&1 || true
        fi
    fi
}

if [ ! -x "$python_bin" ]; then
    show_error "Python 3 non è disponibile. Installa python3 e riavvia l'applicazione."
    exit 1
fi

if [ ! -f "$main_script" ]; then
    show_error "File principale non trovato: $main_script"
    exit 1
fi

if ! check_gui || ! command -v "$adb_command" >/dev/null 2>&1; then
    install_dependencies
fi

if ! check_gui; then
    show_error "Dipendenze grafiche mancanti. Installa python3-gi, gir1.2-gtk-4.0 e gir1.2-adw-1, poi riavvia l'applicazione."
    exit 1
fi

exec "$python_bin" "$main_script" "$@"
