#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
main_script=""
for candidate in "$script_dir/main.py" /usr/lib/installatore-apk/main.py /usr/share/installatore-apk/main.py; do
    if [ -f "$candidate" ]; then
        main_script=$candidate
        break
    fi
done
python_bin=${INSTALLATORE_APK_PYTHON:-/usr/bin/python3}
adb_command=${ADB:-adb}

show_error() {
    message=$1
    printf '%s\n' "$message" >&2
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="Installatore Apk" --text="$message" >/dev/null 2>&1 || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send "Installatore Apk" "$message" >/dev/null 2>&1 || true
    fi
}

check_gui() {
    "$python_bin" -c 'import gi, importlib; gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1"); importlib.import_module("gi.repository.Gtk"); importlib.import_module("gi.repository.Adw")' >/dev/null 2>&1
}

missing_dependencies() {
    missing=""
    check_gui || missing="$missing python3-gi gir1.2-gtk-4.0 gir1.2-adw-1"
    command -v "$adb_command" >/dev/null 2>&1 || missing="$missing adb"
    printf '%s' "${missing# }"
}

install_command() {
    if command -v apt-get >/dev/null 2>&1; then
        printf '%s' "sudo apt install installatore-apk"
    elif command -v dnf5 >/dev/null 2>&1; then
        printf '%s' "sudo dnf5 install installatore-apk"
    elif command -v dnf >/dev/null 2>&1; then
        printf '%s' "sudo dnf install installatore-apk"
    elif command -v pacman >/dev/null 2>&1; then
        printf '%s' "sudo pacman -S installatore-apk"
    else
        printf '%s' "installatore-apk"
    fi
}

if [ ! -x "$python_bin" ]; then
    show_error "Python 3 non è disponibile. Reinstalla il pacchetto installatore-apk e riavvia l'applicazione."
    exit 1
fi

if [ -z "$main_script" ]; then
    show_error "File principale non trovato. Reinstalla il pacchetto installatore-apk."
    exit 1
fi

missing=$(missing_dependencies)
if [ -n "$missing" ]; then
    show_error "Dipendenze mancanti:$missing

Installale con il gestore pacchetti, una volta sola:
  $(install_command)

L'applicazione non installerà nulla da sola e non chiederà mai la
password di amministratore all'avvio."
    exit 1
fi

exec "$python_bin" "$main_script" "$@"
