#!/bin/sh
set -e

install_dependencies() {
    if ! command -v python3 >/dev/null 2>&1; then
        dependencies="python3 python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 adb xdg-utils desktop-file-utils policykit-1"
    elif python3 -c 'import gi, importlib; gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1"); importlib.import_module("gi.repository.Gtk"); importlib.import_module("gi.repository.Adw")' >/dev/null 2>&1 && command -v adb >/dev/null 2>&1; then
        return 0
    else
        dependencies="python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 adb xdg-utils desktop-file-utils policykit-1"
    fi

    if ! python3 -c 'import gi.repository.GdkPixbuf 2' >/dev/null 2>&1 || ! python3 -c '
import gi
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf
raise SystemExit(0 if GdkPixbuf.Pixbuf.get_formats().get("svg") is not None else 1)
' >/dev/null 2>&1; then
        dependencies="$dependencies librsvg2-common"
    fi

    if command -v apt-get >/dev/null 2>&1; then
        if command -v apt-cache >/dev/null 2>&1; then
            if apt-cache show aapt >/dev/null 2>&1; then
                dependencies="$dependencies aapt"
            elif apt-cache show aapt2 >/dev/null 2>&1; then
                dependencies="$dependencies aapt2"
            fi
        fi
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $dependencies >/dev/null 2>&1 || true
    fi
}

install_dependencies

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi

if command -v gtk4-update-icon-cache >/dev/null 2>&1; then
    gtk4-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
elif command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

exit 0
